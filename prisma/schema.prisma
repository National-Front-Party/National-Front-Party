generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model application_status_history {
  id                      BigInt                  @id @default(autoincrement())
  application_id          String                  @db.Uuid
  from_status             String?
  to_status               String
  changed_by              String?                 @db.Uuid
  note                    String?
  changed_at              DateTime                @default(now()) @db.Timestamptz(6)
  membership_applications membership_applications @relation(fields: [application_id], references: [id], onDelete: Cascade)
  staff_users             staff_users?            @relation(fields: [changed_by], references: [id])

  @@index([application_id, changed_at], map: "idx_hist_application")
  @@index([changed_by], map: "idx_hist_changed_by")
}

model central_secretariats {
  id           Int        @id @default(autoincrement()) @db.SmallInt
  info_item_id Int        @db.SmallInt
  name_ar      String
  head_name    String?
  source_note  String?
  sort_order   Int        @default(0) @db.SmallInt
  is_published Boolean    @default(false)
  info_items   info_items @relation(fields: [info_item_id], references: [id], onDelete: Cascade)

  @@index([info_item_id], map: "idx_central_info_item")
}

model governorate_secretariats_info {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  governorate_id Int          @db.SmallInt
  full_name      String
  role_title     String?
  photo_url      String?
  sort_order     Int          @default(0) @db.SmallInt
  is_published   Boolean      @default(false)
  updated_by     String?      @db.Uuid
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
  governorates   governorates @relation(fields: [governorate_id], references: [id])
  staff_users    staff_users? @relation(fields: [updated_by], references: [id])

  @@index([governorate_id], map: "idx_govsec_governorate")
  @@index([updated_by], map: "idx_govsec_updated_by")
}

model governorates {
  id                            Int                             @id @default(autoincrement()) @db.SmallInt
  name_ar                       String
  code                          String                          @unique
  sort_order                    Int                             @default(0) @db.SmallInt
  is_active                     Boolean                         @default(true)
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  governorate_secretariats_info governorate_secretariats_info[]
  members                       members[]
  membership_applications       membership_applications[]
}

model info_items {
  id                   Int                    @id @default(autoincrement()) @db.SmallInt
  slug                 String                 @unique
  title                String
  body                 String?
  source_note          String?
  link_url             String?
  link_label           String?
  icon                 String?
  sort_order           Int                    @default(0) @db.SmallInt
  is_published         Boolean                @default(false)
  updated_by           String?                @db.Uuid
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  kind                 String?
  button_style         String?
  action_type          String?
  panel_id             Int?                   @db.SmallInt
  leader_id            String?                @db.Uuid
  central_secretariats central_secretariats[]
  leaders              leaders?               @relation(fields: [leader_id], references: [id])
  panels               panels?                @relation(fields: [panel_id], references: [id])
  staff_users          staff_users?           @relation(fields: [updated_by], references: [id])

  @@index([leader_id], map: "idx_info_leader")
  @@index([panel_id], map: "idx_info_panel")
  @@index([updated_by], map: "idx_info_updated_by")
}

model leaders {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  panel_id     Int          @db.SmallInt
  full_name    String
  role_title   String?
  photo_url    String?
  badge_label  String?
  is_head      Boolean      @default(false)
  sort_order   Int          @default(0) @db.SmallInt
  is_published Boolean      @default(false)
  updated_by   String?      @db.Uuid
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime     @default(now()) @db.Timestamptz(6)
  info_items   info_items[]
  panels       panels       @relation(fields: [panel_id], references: [id], onDelete: Cascade)
  staff_users  staff_users? @relation(fields: [updated_by], references: [id])

  @@index([panel_id], map: "idx_leaders_panel")
  @@index([updated_by], map: "idx_leaders_updated_by")
}

model members {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id          String                  @unique @db.Uuid
  membership_no           BigInt                  @unique @default(autoincrement())
  governorate_id          Int                     @db.SmallInt
  status                  String                  @default("active")
  joined_at               DateTime                @default(dbgenerated("CURRENT_DATE")) @db.Date
  membership_applications membership_applications @relation(fields: [application_id], references: [id])
  governorates            governorates            @relation(fields: [governorate_id], references: [id])

  @@index([governorate_id], map: "idx_members_governorate")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model membership_applications {
  id                                                           String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_no                                               BigInt                       @unique @default(autoincrement())
  full_name                                                    String
  birth_date                                                   DateTime                     @db.Date
  gender                                                       String
  phone                                                        String
  national_id                                                  String                       @db.Char(14)
  education_level                                              String?
  occupation                                                   String?
  governorate_id                                               Int                          @db.SmallInt
  terms_accepted                                               Boolean                      @default(false)
  status                                                       String                       @default("new")
  assigned_to                                                  String?                      @db.Uuid
  reviewed_by                                                  String?                      @db.Uuid
  reviewed_at                                                  DateTime?                    @db.Timestamptz(6)
  rejection_reason                                             String?
  internal_notes                                               String?
  source                                                       String?
  submitted_ip                                                 String?                      @db.Inet
  created_at                                                   DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                                                   DateTime                     @default(now()) @db.Timestamptz(6)
  application_status_history                                   application_status_history[]
  members                                                      members?
  staff_users_membership_applications_assigned_toTostaff_users staff_users?                 @relation("membership_applications_assigned_toTostaff_users", fields: [assigned_to], references: [id])
  governorates                                                 governorates                 @relation(fields: [governorate_id], references: [id])
  staff_users_membership_applications_reviewed_byTostaff_users staff_users?                 @relation("membership_applications_reviewed_byTostaff_users", fields: [reviewed_by], references: [id])

  @@index([assigned_to], map: "idx_apps_assigned_to")
  @@index([governorate_id], map: "idx_apps_governorate")
  @@index([reviewed_by], map: "idx_apps_reviewed_by")
  @@index([status], map: "idx_apps_status")
}

model ministries {
  id               Int                @id @default(autoincrement()) @db.SmallInt
  slug             String             @unique
  name_ar          String
  sort_order       Int                @default(0) @db.SmallInt
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  service_requests service_requests[]
}

model panels {
  id              Int          @id @default(autoincrement()) @db.SmallInt
  slug            String       @unique
  title           String
  subtitle        String?
  icon            String?
  leaders_heading String?
  sort_order      Int          @default(0) @db.SmallInt
  is_published    Boolean      @default(false)
  info_items      info_items[]
  leaders         leaders[]
}

model parliamentary_unit_items {
  id           Int          @id @default(autoincrement()) @db.SmallInt
  slug         String       @unique
  title        String
  subtitle     String?
  icon         String?
  head_name    String?
  head_role    String?
  body         String?
  source_note  String?
  sort_order   Int          @default(0) @db.SmallInt
  is_published Boolean      @default(false)
  updated_by   String?      @db.Uuid
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime     @default(now()) @db.Timestamptz(6)
  staff_users  staff_users? @relation(fields: [updated_by], references: [id])

  @@index([updated_by], map: "idx_parl_updated_by")
}

model request_sectors {
  id               Int                @id @default(autoincrement()) @db.SmallInt
  code             String             @unique
  name_ar          String
  sort_order       Int                @default(0) @db.SmallInt
  is_active        Boolean            @default(true)
  service_requests service_requests[]
}

model service_requests {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_no      BigInt          @unique @default(autoincrement())
  full_name       String
  phone           String
  ministry_id     Int             @db.SmallInt
  sector_id       Int             @db.SmallInt
  status          String          @default("new")
  assigned_to     String?         @db.Uuid
  internal_notes  String?
  source          String?
  submitted_ip    String?         @db.Inet
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  staff_users     staff_users?    @relation(fields: [assigned_to], references: [id])
  ministries      ministries      @relation(fields: [ministry_id], references: [id])
  request_sectors request_sectors @relation(fields: [sector_id], references: [id])

  @@index([assigned_to], map: "idx_sr_assigned_to")
  @@index([ministry_id], map: "idx_sr_ministry")
  @@index([sector_id], map: "idx_sr_sector")
  @@index([status], map: "idx_sr_status")
}

model staff_users {
  id                                                                       String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name                                                                String
  email                                                                    String                          @unique
  role                                                                     String
  is_active                                                                Boolean                         @default(true)
  created_at                                                               DateTime                        @default(now()) @db.Timestamptz(6)
  application_status_history                                               application_status_history[]
  governorate_secretariats_info                                            governorate_secretariats_info[]
  info_items                                                               info_items[]
  leaders                                                                  leaders[]
  membership_applications_membership_applications_assigned_toTostaff_users membership_applications[]       @relation("membership_applications_assigned_toTostaff_users")
  membership_applications_membership_applications_reviewed_byTostaff_users membership_applications[]       @relation("membership_applications_reviewed_byTostaff_users")
  parliamentary_unit_items                                                 parliamentary_unit_items[]
  service_requests                                                         service_requests[]
}
