// CHECK constraints, triggers, and the convenience view are maintained in the SQL migration.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum application_kind {
  member
  volunteer
  follower
}

enum article_status {
  draft
  pending_review
  changes_requested
  published
}

enum staff_audit_action {
  staff_created
  staff_profile_updated
  staff_role_changed
  staff_activated
  staff_deactivated
  staff_password_reset
  content_created
  content_updated
  content_published
  content_unpublished
  content_deleted
}

model staff_users {
  id                                                  String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name                                           String
  email                                               String                          @unique
  role                                                String
  is_active                                           Boolean                         @default(true)
  created_at                                          DateTime                        @default(now()) @db.Timestamptz(6)
  password_hash                                       String?
  must_change_password                                Boolean                         @default(true)
  last_login_at                                       DateTime?                       @db.Timestamptz(6)
  failed_login_count                                  Int                             @default(0) @db.SmallInt
  locked_until                                        DateTime?                       @db.Timestamptz(6)
  application_status_history                         application_status_history[]
  assigned_membership_applications                   membership_applications[]       @relation("membership_applications_assigned_to")
  reviewed_membership_applications                   membership_applications[]       @relation("membership_applications_reviewed_by")
  assigned_service_requests                          service_requests[]
  updated_governorate_secretariats_info              governorate_secretariats_info[]
  updated_info_items                                 info_items[]
  updated_leaders                                    leaders[]
  updated_parliamentary_unit_items                   parliamentary_unit_items[]
  updated_central_secretariat_people                 central_secretariat_people[]
  updated_party_unit_people                           party_unit_people[]
  updated_news_articles                              news_articles[]
  created_news_articles                              news_articles[]       @relation("news_articles_created_by")
  reviewed_news_articles                             news_articles[]       @relation("news_articles_reviewed_by")
  audit_events_as_actor                              staff_audit_log[]     @relation("staff_audit_actor")
  audit_events_as_target                             staff_audit_log[]     @relation("staff_audit_target")
}

model staff_audit_log {
  id                   BigInt             @id @default(autoincrement())
  actor_id             String             @db.Uuid
  actor_name           String
  actor_email          String
  actor_staff_user_id  String?            @db.Uuid
  target_id            String
  target_name          String
  target_email         String?
  target_staff_user_id String?            @db.Uuid
  action_type          staff_audit_action
  details              Json?              @db.JsonB
  occurred_at          DateTime           @default(now()) @db.Timestamptz(6)

  actor_staff_user  staff_users? @relation("staff_audit_actor", fields: [actor_staff_user_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  target_staff_user staff_users? @relation("staff_audit_target", fields: [target_staff_user_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([target_id, occurred_at(sort: Desc)], map: "idx_staff_audit_target_time")
  @@index([actor_id, occurred_at(sort: Desc)], map: "idx_staff_audit_actor_time")
  @@index([occurred_at(sort: Desc)], map: "idx_staff_audit_time")
  @@index([actor_staff_user_id], map: "idx_staff_audit_actor_fk")
  @@index([target_staff_user_id], map: "idx_staff_audit_target_fk")
}

model governorates {
  id                            Int                             @id @default(autoincrement()) @db.SmallInt
  name_ar                       String
  code                          String                          @unique
  sort_order                    Int                             @default(0) @db.SmallInt
  is_active                     Boolean                         @default(true)
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  members                       members[]
  membership_applications       membership_applications[]
  governorate_secretariats_info governorate_secretariats_info[]
  centers                       centers[]
}

model membership_applications {
  id                 String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_no     BigInt                       @unique @default(autoincrement())
  application_type   application_kind
  full_name          String
  birth_date         DateTime                     @db.Date
  gender             String
  phone              String
  national_id        String                       @db.Char(14)
  education_level    String?
  occupation         String?
  governorate_id     Int                          @db.SmallInt
  terms_accepted     Boolean                      @default(false)
  status             String                       @default("new")
  assigned_to        String?                      @db.Uuid
  reviewed_by        String?                      @db.Uuid
  reviewed_at        DateTime?                    @db.Timestamptz(6)
  rejection_reason   String?
  internal_notes     String?
  source             String?
  submitted_ip       String?                      @db.Inet
  created_at         DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                     @default(now()) @db.Timestamptz(6)
  application_status_history application_status_history[]
  members            members?
  assigned_staff_user staff_users?                @relation("membership_applications_assigned_to", fields: [assigned_to], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewed_staff_user staff_users?                @relation("membership_applications_reviewed_by", fields: [reviewed_by], references: [id], onDelete: SetNull, onUpdate: Cascade)
  governorate        governorates                 @relation(fields: [governorate_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([governorate_id], map: "idx_apps_governorate")
  @@index([assigned_to], map: "idx_apps_assigned_to")
  @@index([reviewed_by], map: "idx_apps_reviewed_by")
  @@index([status], map: "idx_apps_status")
}

model members {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id          String                  @unique @db.Uuid
  membership_no           BigInt                  @unique @default(autoincrement())
  governorate_id          Int                     @db.SmallInt
  status                  String                  @default("active")
  joined_at               DateTime                @default(dbgenerated("CURRENT_DATE")) @db.Date
  membership_application  membership_applications @relation(fields: [application_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  governorate             governorates            @relation(fields: [governorate_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  party_unit_people        party_unit_people[]

  @@index([governorate_id], map: "idx_members_governorate")
}

model application_status_history {
  id                      BigInt                  @id @default(autoincrement())
  application_id          String                  @db.Uuid
  from_status             String?
  to_status               String
  changed_by              String?                 @db.Uuid
  note                    String?
  changed_at              DateTime                @default(now()) @db.Timestamptz(6)
  membership_application  membership_applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  changed_by_staff_user   staff_users?            @relation(fields: [changed_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([application_id, changed_at], map: "idx_hist_application")
  @@index([changed_by], map: "idx_hist_changed_by")
}

model panels {
  id              Int          @id @default(autoincrement()) @db.SmallInt
  slug            String       @unique
  title           String
  subtitle        String?
  icon            String?
  leaders_heading String?
  sort_order      Int          @default(0) @db.SmallInt
  is_published    Boolean      @default(false)
  leaders         leaders[]
  info_items      info_items[]
}

model leaders {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  panel_id          Int          @db.SmallInt
  full_name         String
  role_title        String?
  photo_url         String?
  badge_label       String?
  is_head           Boolean      @default(false)
  sort_order        Int          @default(0) @db.SmallInt
  is_published      Boolean      @default(false)
  updated_by        String?      @db.Uuid
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @default(now()) @db.Timestamptz(6)
  panel             panels       @relation(fields: [panel_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updated_by_user   staff_users? @relation(fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: Cascade)
  info_items        info_items[]

  @@index([panel_id], map: "idx_leaders_panel")
  @@index([updated_by], map: "idx_leaders_updated_by")
}

model info_items {
  id                Int                    @id @default(autoincrement()) @db.SmallInt
  slug              String                 @unique
  title             String
  body              String?
  source_note       String?
  link_url          String?
  link_label        String?
  icon              String?
  sort_order        Int                    @default(0) @db.SmallInt
  is_published      Boolean                @default(false)
  updated_by        String?                @db.Uuid
  created_at        DateTime               @default(now()) @db.Timestamptz(6)
  updated_at        DateTime               @default(now()) @db.Timestamptz(6)
  kind              String?
  button_style      String?
  action_type       String?
  panel_id          Int?                   @db.SmallInt
  leader_id         String?                @db.Uuid
  button_label      String?
  person_name       String?
  person_role_title String?
  decision_number   String?
  decision_date     DateTime?              @db.Date
  updated_by_user   staff_users?           @relation(fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: Cascade)
  panel             panels?                @relation(fields: [panel_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  leader            leaders?               @relation(fields: [leader_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  central_secretariats central_secretariats[]

  @@index([updated_by], map: "idx_info_updated_by")
  @@index([panel_id], map: "idx_info_panel")
  @@index([leader_id], map: "idx_info_leader")
}

model central_secretariats {
  id           Int                         @id @default(autoincrement()) @db.SmallInt
  info_item_id Int                         @db.SmallInt
  name_ar      String
  head_name    String?
  source_note  String?
  sort_order   Int                         @default(0) @db.SmallInt
  is_published Boolean                     @default(false)
  info_item    info_items                  @relation(fields: [info_item_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  people       central_secretariat_people[]

  @@index([info_item_id], map: "idx_central_info_item")
}

model central_secretariat_people {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  secretariat_id Int                  @db.SmallInt
  full_name      String
  position_title String?
  image_url      String?
  details        String?
  sort_order     Int                  @default(0) @db.SmallInt
  is_published   Boolean              @default(false)
  updated_by     String?              @db.Uuid
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  updated_at     DateTime             @default(now()) @db.Timestamptz(6)
  secretariat    central_secretariats @relation(fields: [secretariat_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updated_by_user staff_users?        @relation(fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([secretariat_id], map: "idx_csp_secretariat")
  @@index([updated_by], map: "idx_csp_updated_by")
}

model governorate_secretariats_info {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  governorate_id Int          @db.SmallInt
  full_name      String
  role_title     String?
  photo_url      String?
  sort_order     Int          @default(0) @db.SmallInt
  is_published   Boolean      @default(false)
  updated_by     String?      @db.Uuid
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
  governorate    governorates @relation(fields: [governorate_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updated_by_user staff_users? @relation(fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([governorate_id], map: "idx_govsec_governorate")
  @@index([updated_by], map: "idx_govsec_updated_by")
}

model parliamentary_unit_items {
  id              Int          @id @default(autoincrement()) @db.SmallInt
  slug            String       @unique
  title           String
  subtitle        String?
  icon            String?
  head_name       String?
  head_role       String?
  body            String?
  source_note     String?
  sort_order      Int          @default(0) @db.SmallInt
  is_published    Boolean      @default(false)
  updated_by      String?      @db.Uuid
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_by_user staff_users? @relation(fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([updated_by], map: "idx_parl_updated_by")
}

model ministries {
  id               Int                @id @default(autoincrement()) @db.SmallInt
  slug             String             @unique
  name_ar          String
  sort_order       Int                @default(0) @db.SmallInt
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  service_requests service_requests[]
}

model request_sectors {
  id               Int                @id @default(autoincrement()) @db.SmallInt
  code             String             @unique
  name_ar          String
  sort_order       Int                @default(0) @db.SmallInt
  is_active        Boolean            @default(true)
  service_requests service_requests[]
}

model service_requests {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_no          BigInt          @unique @default(autoincrement())
  full_name           String
  phone               String
  ministry_id         Int             @db.SmallInt
  sector_id           Int             @db.SmallInt
  status              String          @default("new")
  assigned_to         String?         @db.Uuid
  internal_notes      String?
  source              String?
  submitted_ip        String?         @db.Inet
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @default(now()) @db.Timestamptz(6)
  assigned_staff_user staff_users?    @relation(fields: [assigned_to], references: [id], onDelete: SetNull, onUpdate: Cascade)
  ministry            ministries      @relation(fields: [ministry_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  request_sector      request_sectors @relation(fields: [sector_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ministry_id], map: "idx_sr_ministry")
  @@index([sector_id], map: "idx_sr_sector")
  @@index([assigned_to], map: "idx_sr_assigned_to")
  @@index([status], map: "idx_sr_status")
}

model news_sources {
  id              Int             @id @default(autoincrement()) @db.SmallInt
  slug            String          @unique
  name_ar         String
  sort_order      Int             @default(0) @db.SmallInt
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  news_articles   news_articles[]
}

model news_articles {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String       @unique
  title           String
  body            String
  image_url       String?
  image_alt       String?
  source_name     String?
  source_id       Int?          @db.SmallInt
  source_url      String?
  published_on    DateTime      @db.Date
  date_precision  String        @default("day")
  is_featured     Boolean       @default(false)
  sort_order      Int           @default(0) @db.SmallInt
  is_published    Boolean       @default(false)
  status          article_status
  created_by      String?       @db.Uuid
  reviewed_by     String?       @db.Uuid
  reviewed_at     DateTime?     @db.Timestamp(6)
  review_note     String?
  updated_by      String?       @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  source          news_sources? @relation(fields: [source_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updated_by_user staff_users? @relation(fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: Cascade)
  created_by_user staff_users? @relation("news_articles_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewed_by_user staff_users? @relation("news_articles_reviewed_by", fields: [reviewed_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([source_id], map: "idx_news_articles_source_id")
  @@index([updated_by], map: "idx_news_articles_updated_by")
  @@index([is_published, published_on(sort: Desc)], map: "idx_news_articles_published_listing")
}

model party_programs {
  id           Int      @id @default(autoincrement()) @db.SmallInt
  title        String   @default("برنامج الحزب")
  body         String
  source_note  String?  @default("الموقع الرسمي للحزب")
  is_published Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
}


model centers {
  id              Int                 @id @default(autoincrement()) @db.SmallInt
  governorate_id  Int                 @db.SmallInt
  name_ar         String
  sort_order      Int                 @default(0) @db.SmallInt
  is_active       Boolean             @default(true)
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  governorate     governorates        @relation(fields: [governorate_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  local_secretariats local_secretariats[]

  @@unique([governorate_id, name_ar], map: "centers_governorate_name_key")
  @@index([governorate_id], map: "idx_centers_governorate")
}

model local_secretariats {
  id          Int          @id @default(autoincrement()) @db.SmallInt
  center_id   Int          @db.SmallInt
  name_ar     String
  sort_order  Int          @default(0) @db.SmallInt
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  center      centers      @relation(fields: [center_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  party_units party_units[]

  @@unique([center_id, name_ar], map: "local_secretariats_center_name_key")
  @@index([center_id], map: "idx_local_secretariats_center")
}

model party_units {
  id             Int                  @id @default(autoincrement()) @db.SmallInt
  secretariat_id Int                  @db.SmallInt
  name_ar        String
  description    String?
  sort_order     Int                  @default(0) @db.SmallInt
  is_active      Boolean              @default(true)
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  secretariat    local_secretariats   @relation(fields: [secretariat_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  people         party_unit_people[]

  @@unique([secretariat_id, name_ar], map: "party_units_secretariat_name_key")
  @@index([secretariat_id], map: "idx_party_units_secretariat")
}

model party_unit_people {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  party_unit_id   Int          @db.SmallInt
  member_id       String?      @db.Uuid
  full_name       String?
  position_title  String
  details         String?
  sort_order      Int          @default(0) @db.SmallInt
  is_published    Boolean      @default(false)
  updated_by      String?      @db.Uuid
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @db.Timestamptz(6)
  party_unit      party_units  @relation(fields: [party_unit_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  member          members?     @relation(fields: [member_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updated_by_user staff_users? @relation(fields: [updated_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([party_unit_id, member_id], map: "party_unit_people_unit_member_key")
  @@index([party_unit_id, is_published, sort_order], map: "idx_party_unit_people_listing")
  @@index([member_id], map: "idx_party_unit_people_member")
  @@index([updated_by], map: "idx_party_unit_people_updated_by")
}
