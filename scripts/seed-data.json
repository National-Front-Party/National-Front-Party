    "modal": {
      "title": "رؤية مصر 2030",
      "paras": [
        "أطلقت مصر عام 2016 النسخة الأولى من استراتيجية التنمية المستدامة: رؤية مصر 2030، ثم أصدرت وزارة التخطيط والتنمية الاقتصادية نسخة محدثة منها تضم أربعة مبادئ حاكمة وستة أهداف استراتيجية وسبعة ممكنات.",
        "المبادئ الحاكمة: الإنسان محور التنمية، تحقيق العدالة والإتاحة، المرونة والقدرة على التكيف، الاستدامة.",
        "الممكنات السبعة: توفير التمويل، التقدم التكنولوجي والابتكار، التحول الرقمي، إنتاج البيانات وإتاحتها، بيئة تشريعية ومؤسسية داعمة، منظومة قيم ثقافية مساندة، ضبط الزيادة السكانية."
      ],
      "note": "المصدر: وزارة التخطيط والتنمية الاقتصادية",
      "link": "https://mped.gov.eg/DynamicPage?id=115",
      "linkLabel": "صفحة الرؤية على موقع الوزارة"
    }
  },
